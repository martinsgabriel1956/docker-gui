{
  "name": "docker-gui-dev",
  "private": true,
  "type": "module",
  "description": "Ferramentas de desenvolvimento. Quem só usa o docker_gui.py não precisa de nada disto.",
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "python3 build.py",
    "test:js": "node --test tests/format.test.js tests/transport-desktop.test.js",
    "test:e2e": "playwright test",
    "build:harness": "cargo build --manifest-path src-tauri/Cargo.toml -p stivo-core --features harness",
    "test:e2e:rust": "npm run build:harness && GUI_BACKEND=rust playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "imports": {
    "#transport": {
      "desktop": "./src/transport-desktop.ts",
      "default": "./src/transport-web.ts"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  }
}
