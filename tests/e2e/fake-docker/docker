#!/usr/bin/env python3
"""docker falso para os testes de UI: lê e grava o estado num JSON ($FAKE_DOCKER_STATE).

Cenários que o Docker de verdade não reproduz sob demanda (healthcheck falhando, loop de reinício,
ação que falha ou demora) viram dados. Campos extras por container, fora do formato do `docker ps`:
  logs    texto do `docker logs` (respeita o --tail); com -f, o que for acrescentado depois sai na hora
  health  objeto do `inspect --format {{json .State.Health}}`
  inspect objeto do `inspect --format {{json .}}` (HostConfig, NetworkSettings, Mounts, Config...)
  fail    {ação: stderr}: a ação falha com essa mensagem
  delay   {ação: segundos}: a ação demora (para ver o estado "ocupado" na tela)
  after   {ação: {State, Status}}: estado depois da ação, no lugar do padrão (ex.: start que cai)
  stats   {CPUPerc, MemUsage, MemPerc, NetIO, BlockIO}: linha do `docker stats`; sem ele, o container não
          aparece lá. Numa lista, cada `docker stats` usa o item seguinte (o último se repete), para a
          página ver os números mudando; "stats_calls", no topo do JSON, conta as leituras
No topo do JSON, "ps_error" faz o `docker ps` (e o `docker events`) falhar (daemon fora do ar),
"events_error" faz só o `docker events` falhar (como um podman sem events), "df" é a saída do
`docker system df` (lista de linhas) e "pruned" registra os prunes que rodaram. O prune zera o
"Reclaimable" da categoria e diz que liberou o que estava lá. "compose_fail" faz todo
`docker compose` falhar com esse stderr, e cada `docker compose` grava o argv em "compose_calls".
`compose up` (com ou sem --build) deixa os containers do projeto rodando, `down` os remove, `pull` não
muda nada, `restart <serviço>` deixa os containers do serviço rodando e `logs` junta os logs do projeto
com o prefixo do serviço ("api-1  | "), como o compose; com --follow, acompanha como o `logs -f`.
"images", "volumes" e "networks" são as linhas do `image ls`/`volume ls`/`network ls` (uma por tag, no caso
das imagens). Quem usa cada uma sai do "inspect" dos containers (Image, Mounts, NetworkSettings.Networks): o rm
recusa o que está em uso, com a mensagem do docker, e cada rm que deu certo fica em "removed".
`run -d` grava o argv em "run_calls" e cria o container rodando, com nome, imagem e portas do argv; "run_fail"
faz o run falhar com esse stderr, "run_delay" o faz demorar (segundos) e "run_after" ({State, Status}) é o estado
do container criado (ex.: um que sobe e cai).
O `docker exec -it` do terminal vira um sh local; o `docker exec -i` do modo do Windows roda o comando do
container aqui mesmo (com o `script` local), e "noscript": true simula uma imagem sem `script` (alpine).
O `docker events` manda uma linha por container que mudou
no que o `docker ps` mostra, enquanto o servidor o mantiver vivo.
"""
import contextlib
import fcntl
import hashlib
import json
import os
import re
import secrets
import sys
import time

PS_FIELDS = ("Command", "CreatedAt", "ID", "Image", "Labels", "LocalVolumes", "Mounts", "Names",
             "Networks", "Ports", "RunningFor", "Size", "State", "Status")
RUNNING = {"State": "running", "Status": "Up Less than a second"}
PRUNE_TYPE = {"image": "Images", "volume": "Local Volumes", "builder": "Build Cache"}
AFTER = {"start": RUNNING, "restart": RUNNING, "unpause": RUNNING,
         "stop": {"State": "exited", "Status": "Exited (0) Less than a second ago"},
         "pause": {"State": "paused", "Status": "Up Less than a second (Paused)"}}


def fail(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def find(state, ref):
    for c in state["containers"]:
        if c["ID"].startswith(ref) or ref.startswith(c["ID"]):
            return c
    fail(f"Error response from daemon: No such container: {ref}")


@contextlib.contextmanager
def locked(path, exclusive):
    """Abre o estado com lock (o servidor atende requisições em paralelo); fechar solta o lock."""
    with open(path, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        yield f, json.load(f)


def save(f, state):
    f.seek(0)
    f.truncate()
    json.dump(state, f)


def tail(logs, args):
    """--tail N: só as últimas N linhas; sem ele, tudo (como o docker)."""
    if "--tail" not in args:
        return logs
    return "".join(logs.splitlines(keepends=True)[-int(args[args.index("--tail") + 1]):])


def follow(path, pick, fmt=lambda c, text: text, args=()):
    """logs -f: manda o que já tem (respeitando o --tail), depois só o que for acrescentado; termina quando
    nenhum dos containers acompanhados (pick: um no docker logs, o projeto no compose logs) está rodando, como o docker."""
    sent = {}
    while True:
        with locked(path, exclusive=False) as (_, state):
            cs = pick(state)
        for c in cs:
            logs = c.get("logs", "")
            sys.stdout.write(fmt(c, tail(logs, args) if c["ID"] not in sent else logs[sent[c["ID"]]:]))
            sent[c["ID"]] = len(logs)
        sys.stdout.flush()
        if not any(c["State"] in ("running", "paused") for c in cs):
            return
        time.sleep(0.2)  # dorme fora do lock


def events(path):
    """events: olha o estado a cada 50 ms. O docker de verdade não avisa a passagem do tempo ("Up 5 minutes"),
    mas aqui qualquer mudança no ps vale um evento: é assim que os testes mudam o "mundo" por fora."""
    seen, parent = None, os.getppid()
    while os.getppid() == parent:  # servidor morto (gui.stop()): sem isto o falso ficaria órfão, em loop
        with locked(path, exclusive=False) as (_, state):
            err = state.get("events_error") or state.get("ps_error")
            now = {c["ID"]: [c.get(k, "") for k in PS_FIELDS] for c in state["containers"]}
        if err:  # o docker events termina quando o daemon cai
            fail(err)
        if seen is not None:
            for cid in sorted(seen.keys() | now.keys()):
                if seen.get(cid) != now.get(cid):
                    action = "destroy" if cid not in now else "create" if cid not in seen else "update"
                    print(json.dumps({"Type": "container", "Action": action, "Actor": {"ID": cid}}), flush=True)
        seen = now
        time.sleep(0.05)  # dorme fora do lock


def labels(c):
    # valor pode ter vírgula (config_files): só quebra antes de uma vírgula seguida de "chave="
    return dict(re.findall(r"(?:^|,)([\w.-]+)=((?:[^,]|,(?![\w.-]+=))*)", c.get("Labels", "")))


def project(state, args):
    p = args[args.index("-p") + 1]
    return [c for c in state["containers"] if labels(c).get("com.docker.compose.project") == p]


def prefixed(c, text):
    # o compose prefixa cada linha com o nome do container sem o projeto ("api-1")
    svc = labels(c).get("com.docker.compose.service", "")
    return "".join(f"{svc}-1  | {line}" for line in text.splitlines(keepends=True))


def subcommand(args):
    """compose -p X --project-directory D -f F... <sub> <resto>: pula as flags globais."""
    i = 0
    while args[i] in ("-p", "--project-directory", "-f"):
        i += 2
    return args[i], args[i + 1:]


def using(state, kind, key):
    """Containers que usam a imagem (ID), o volume ou a rede (nome), pelo inspect, como o servidor lê."""
    out = []
    for c in state["containers"]:
        i = c.get("inspect", {})
        refs = {"image": [i.get("Image", "").split(":")[-1]],
                "volume": [m.get("Name") for m in i.get("Mounts", []) if m.get("Type") == "volume"],
                "network": list(i.get("NetworkSettings", {}).get("Networks", {}))}[kind]
        if key in refs:
            out.append(c)
    return out


def objects(state, args):
    """image/volume/network ls e rm, e o `network inspect --format {{.Name}}`. Devolve True se mudou o estado."""
    kind, sub, ref = args[0], args[1], args[-1]
    items = state.get(kind + "s", [])
    if sub == "ls":
        for row in items:
            print(json.dumps(row))
        return False
    match = [r for r in items if (r["Name"] == ref if kind == "volume" else r["ID"].split(":")[-1].startswith(ref))]
    if not match:
        fail({"image": f"Error response from daemon: No such image: {ref}:latest",
              "volume": f"Error response from daemon: get {ref}: no such volume",
              "network": f"Error response from daemon: network {ref} not found"}[kind])
    if sub == "inspect":
        print(match[0]["Name"])
        return False
    users = using(state, kind, match[0]["Name"] if kind == "volume" else match[0]["ID"].split(":")[-1])
    if kind == "image" and len(match) > 1:
        fail(f"Error response from daemon: conflict: unable to delete {ref} (must be forced) - image is referenced in multiple repositories")
    if kind == "image" and users:
        u = users[0]
        running = u["State"] == "running"
        fail(f"Error response from daemon: conflict: unable to delete {ref} ({'cannot' if running else 'must'} be forced) - "
             f"image is being used by {'running' if running else 'stopped'} container {u['ID']}")
    if kind == "volume" and users:
        fail(f"Error response from daemon: remove {ref}: volume is in use - [{', '.join(u['ID'] for u in users)}]")
    if kind == "network" and match[0]["Name"] in ("bridge", "host", "none"):
        fail(f"Error response from daemon: {match[0]['Name']} is a pre-defined network and cannot be removed")
    if kind == "network" and users:
        fail(f"Error response from daemon: error while removing network: network {match[0]['Name']} has active endpoints "
             f'(name:"{users[0]["Names"]}" id:"{users[0]["ID"]}")')
    for r in match:
        items.remove(r)
    state.setdefault("removed", []).append(" ".join(args))
    print(ref)
    return True


def compose(state, args):
    state.setdefault("compose_calls", []).append(["compose", *args])
    if state.get("compose_fail"):
        return state["compose_fail"]
    sub, rest = subcommand(args)
    mine = project(state, args)
    if sub == "restart":
        mine = [c for c in mine if labels(c).get("com.docker.compose.service") == rest[-1]]
        if not mine:
            return f"no such service: {rest[-1]}"
    for c in mine:
        if sub == "down":
            state["containers"].remove(c)
        elif sub in ("up", "restart"):
            c.update(RUNNING)
        elif sub == "logs" and "--follow" not in rest:
            sys.stdout.write(prefixed(c, tail(c.get("logs", ""), rest)))
    return None


def run(state, args):
    """docker run -d: confere a forma do argv que o servidor monta e cria o container. Devolve (ID inteiro, erro)."""
    state.setdefault("run_calls", []).append(args)
    if state.get("run_fail"):
        return None, state["run_fail"]
    if args[:2] != ["run", "-d"] or args[-2] != "--":
        return None, f"run inesperado: {args}"
    opts = dict(a.split("=", 1) for a in args[2:-2] if a.startswith("--"))
    name = opts.get("--name") or f"fake_{secrets.token_hex(3)}"
    if any(c["Names"] == name for c in state["containers"]):
        return None, f'docker: Error response from daemon: Conflict. The container name "/{name}" is already in use.'
    full = hashlib.sha256(name.encode()).hexdigest()  # mesmo ID do id() dos testes (fixtures.ts)
    # -p 127.0.0.1:8080:80/tcp -> "127.0.0.1:8080->80/tcp", como no docker ps
    ports = [re.sub(r"^(.*):(\d+):", r"\1:\2->", v) for f, v in zip(args, args[1:]) if f == "-p"]
    state["containers"].append({"ID": full[:12], "Names": name, "Image": args[-1], "Ports": ", ".join(ports), "Labels": "",
                                **RUNNING, **state.get("run_after", {})})
    return full, None


def main(args):
    path = os.environ["FAKE_DOCKER_STATE"]
    cmd, ref = args[0], args[-1]
    action = "remove" if cmd == "rm" else cmd
    if cmd == "logs" and "-f" in args:
        return follow(path, lambda state: [find(state, ref)], args=args)
    if cmd == "events":
        if args[1:] != ["--format", "{{json .}}", "--filter", "type=container"]:
            fail(f"events inesperado: {args}")
        return events(path)

    if cmd == "exec":
        # terminal: confere o argv que o servidor monta e roda um sh local no lugar do container
        pty = args[:2] == ["exec", "-it"] and args[3:] == ["sh", "-c", "exec $(command -v bash || echo sh)"]
        # modo do Windows (DOCKER_GUI_TERMINAL=pipe): o comando do container roda aqui, com o script local;
        # o exec sem -i é o stty do redimensionamento
        pipe = args[1:2] == ["-i"] and args[3:5] == ["sh", "-c"] or args[2:4] == ["sh", "-c"]
        if not (pty or pipe):
            fail(f"exec inesperado: {args}")
        cid = args[2] if args[1].startswith("-") else args[1]
        with locked(path, exclusive=False) as (_, state):
            c = find(state, cid)
            if c["State"] != "running":
                fail(f"Error response from daemon: container {cid} is not running")
        os.environ.update({"PS1": "$ ", "HOME": os.path.dirname(path), "HISTFILE": os.devnull, "SHELL": "/bin/sh"})
        if pty:
            os.execvp("sh", ["sh"])
        if c.get("noscript"):  # imagem sem script (alpine): só o sh no PATH
            nobin = os.path.join(os.path.dirname(path), "nobin")
            os.makedirs(nobin, exist_ok=True)
            with contextlib.suppress(FileExistsError):
                os.symlink("/bin/sh", os.path.join(nobin, "sh"))
            os.environ["PATH"] = nobin
        cmd = args[3:] if args[1] == "-i" else args[2:]
        os.execvp(cmd[0], cmd)

    if cmd == "run":  # dorme fora do lock, como as ações
        with locked(path, exclusive=False) as (_, state):
            delay = state.get("run_delay", 0)
        time.sleep(delay)

    if action in AFTER or action == "remove":
        # dorme fora do lock, senão o `docker ps` do poll travaria junto
        with locked(path, exclusive=False) as (_, state):
            delay = find(state, ref).get("delay", {}).get(action, 0)
        time.sleep(delay)

    with locked(path, exclusive=True) as (f, state):
        if cmd == "ps":
            if state.get("ps_error"):
                fail(state["ps_error"])
            if "-q" in args:  # ps -a -q --no-trunc: quem usa imagens, volumes e redes
                print("\n".join(c["ID"] for c in state["containers"]))
                return
            for c in state["containers"]:
                if "--filter" not in args:
                    print(json.dumps({k: c.get(k, "") for k in PS_FIELDS}))
                elif "com.docker.compose.project" in labels(c):  # o COMPOSE_FORMAT do servidor
                    print(json.dumps([labels(c).get("com.docker.compose." + k, "")
                                      for k in ("project", "project.working_dir", "project.config_files", "service")]))
        elif cmd == "run":
            cid, err = run(state, args)
            save(f, state)
            if err:
                fail(err, 125)
            print(cid)
        elif cmd == "compose":
            err = compose(state, args[1:])
            save(f, state)
            if err:
                fail(err)
        elif cmd == "stats":
            n = state["stats_calls"] = state.get("stats_calls", 0) + 1
            save(f, state)
            for c in state["containers"]:
                if "stats" in c:
                    s = c["stats"]
                    s = s[min(n, len(s)) - 1] if isinstance(s, list) else s
                    print(json.dumps({"ID": c["ID"], "Name": c["Names"], **s}))
        elif cmd == "system":
            for row in state.get("df", []):
                print(json.dumps(row))
        elif cmd in ("image", "volume", "network") and args[1] != "prune":
            if objects(state, args):
                save(f, state)
        elif cmd == "container":  # container inspect <ids...>: um array, como o docker
            print(json.dumps([{"Name": "/" + c["Names"], **c.get("inspect", {})}
                              for c in state["containers"] if c["ID"] in args[2:]]))
        elif cmd in PRUNE_TYPE:
            row = next(r for r in state["df"] if r["Type"] == PRUNE_TYPE[cmd])
            freed, row["Reclaimable"] = row["Reclaimable"].split()[0], "0B"
            state.setdefault("pruned", []).append(" ".join(args))
            save(f, state)
            # o builder prune resume diferente dos outros
            print(f"Total:\t{freed}" if cmd == "builder" else f"Total reclaimed space: {freed}")
        elif cmd == "logs":
            sys.stdout.write(tail(find(state, ref).get("logs", ""), args))
        elif cmd == "inspect":
            c = find(state, ref)
            print(json.dumps(c.get("health") if ".State.Health" in args[-2] else c.get("inspect", {})))
        else:
            c = find(state, ref)
            if action in c.get("fail", {}):
                fail(c["fail"][action])
            if action == "remove":
                state["containers"].remove(c)
            else:
                c.update(c.get("after", {}).get(action) or AFTER[action])
            save(f, state)

    # compose logs --follow: a chamada já ficou registrada; acompanha fora do lock, que o follow pega a cada volta
    if cmd == "compose" and subcommand(args[1:])[0] == "logs" and "--follow" in args:
        follow(path, lambda state: project(state, args[1:]), prefixed, args)


if __name__ == "__main__":
    main(sys.argv[1:])
