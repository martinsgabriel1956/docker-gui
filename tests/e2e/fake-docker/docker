#!/usr/bin/env python3
"""docker falso para os testes de UI: lê e grava o estado num JSON ($FAKE_DOCKER_STATE).

Cenários que o Docker de verdade não reproduz sob demanda (healthcheck falhando, loop de reinício,
ação que falha ou demora) viram dados. Campos extras por container, fora do formato do `docker ps`:
  logs    texto do `docker logs`; com -f, o que for acrescentado depois sai na hora
  health  objeto do `inspect --format {{json .State.Health}}`
  inspect objeto do `inspect --format {{json .}}` (HostConfig, NetworkSettings, Mounts, Config...)
  fail    {ação: stderr}: a ação falha com essa mensagem
  delay   {ação: segundos}: a ação demora (para ver o estado "ocupado" na tela)
  after   {ação: {State, Status}}: estado depois da ação, no lugar do padrão (ex.: start que cai)
  stats   {CPUPerc, MemUsage, MemPerc}: linha do `docker stats`; sem ele, o container não aparece lá
No topo do JSON, "ps_error" faz o `docker ps` falhar (daemon fora do ar), "df" é a saída do
`docker system df` (lista de linhas) e "pruned" registra os prunes que rodaram. O prune zera o
"Reclaimable" da categoria e diz que liberou o que estava lá. "compose_fail" faz todo
`docker compose` falhar com esse stderr, e cada `docker compose` grava o argv em "compose_calls".
`compose up` deixa os containers do projeto rodando, `down` os remove e `pull` não muda nada.
"images", "volumes" e "networks" são as linhas do `image ls`/`volume ls`/`network ls` (uma por tag, no caso
das imagens). Quem usa cada uma sai do "inspect" dos containers (Image, Mounts, NetworkSettings.Networks): o rm
recusa o que está em uso, com a mensagem do docker, e cada rm que deu certo fica em "removed".
O `docker exec -it` do terminal vira um sh local.
"""
import contextlib
import fcntl
import json
import os
import re
import sys
import time

PS_FIELDS = ("Command", "CreatedAt", "ID", "Image", "Labels", "LocalVolumes", "Mounts", "Names",
             "Networks", "Ports", "RunningFor", "Size", "State", "Status")
RUNNING = {"State": "running", "Status": "Up Less than a second"}
PRUNE_TYPE = {"image": "Images", "volume": "Local Volumes", "builder": "Build Cache"}
AFTER = {"start": RUNNING, "restart": RUNNING, "unpause": RUNNING,
         "stop": {"State": "exited", "Status": "Exited (0) Less than a second ago"},
         "pause": {"State": "paused", "Status": "Up Less than a second (Paused)"}}


def fail(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


def find(state, ref):
    for c in state["containers"]:
        if c["ID"].startswith(ref) or ref.startswith(c["ID"]):
            return c
    fail(f"Error response from daemon: No such container: {ref}")


@contextlib.contextmanager
def locked(path, exclusive):
    """Abre o estado com lock (o servidor atende requisições em paralelo); fechar solta o lock."""
    with open(path, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        yield f, json.load(f)


def save(f, state):
    f.seek(0)
    f.truncate()
    json.dump(state, f)


def follow(path, ref):
    """logs -f: manda o que já tem, depois só o que for acrescentado; termina quando o container para, como o docker."""
    sent = 0
    while True:
        with locked(path, exclusive=False) as (_, state):
            c = find(state, ref)
        logs = c.get("logs", "")
        sys.stdout.write(logs[sent:])
        sys.stdout.flush()
        sent = len(logs)
        if c["State"] not in ("running", "paused"):
            return
        time.sleep(0.2)  # dorme fora do lock


def labels(c):
    # valor pode ter vírgula (config_files): só quebra antes de uma vírgula seguida de "chave="
    return dict(re.findall(r"(?:^|,)([\w.-]+)=((?:[^,]|,(?![\w.-]+=))*)", c.get("Labels", "")))


def using(state, kind, key):
    """Containers que usam a imagem (ID), o volume ou a rede (nome), pelo inspect, como o servidor lê."""
    out = []
    for c in state["containers"]:
        i = c.get("inspect", {})
        refs = {"image": [i.get("Image", "").split(":")[-1]],
                "volume": [m.get("Name") for m in i.get("Mounts", []) if m.get("Type") == "volume"],
                "network": list(i.get("NetworkSettings", {}).get("Networks", {}))}[kind]
        if key in refs:
            out.append(c)
    return out


def objects(state, args):
    """image/volume/network ls e rm, e o `network inspect --format {{.Name}}`. Devolve True se mudou o estado."""
    kind, sub, ref = args[0], args[1], args[-1]
    items = state.get(kind + "s", [])
    if sub == "ls":
        for row in items:
            print(json.dumps(row))
        return False
    match = [r for r in items if (r["Name"] == ref if kind == "volume" else r["ID"].split(":")[-1].startswith(ref))]
    if not match:
        fail({"image": f"Error response from daemon: No such image: {ref}:latest",
              "volume": f"Error response from daemon: get {ref}: no such volume",
              "network": f"Error response from daemon: network {ref} not found"}[kind])
    if sub == "inspect":
        print(match[0]["Name"])
        return False
    users = using(state, kind, match[0]["Name"] if kind == "volume" else match[0]["ID"].split(":")[-1])
    if kind == "image" and len(match) > 1:
        fail(f"Error response from daemon: conflict: unable to delete {ref} (must be forced) - image is referenced in multiple repositories")
    if kind == "image" and users:
        u = users[0]
        running = u["State"] == "running"
        fail(f"Error response from daemon: conflict: unable to delete {ref} ({'cannot' if running else 'must'} be forced) - "
             f"image is being used by {'running' if running else 'stopped'} container {u['ID']}")
    if kind == "volume" and users:
        fail(f"Error response from daemon: remove {ref}: volume is in use - [{', '.join(u['ID'] for u in users)}]")
    if kind == "network" and match[0]["Name"] in ("bridge", "host", "none"):
        fail(f"Error response from daemon: {match[0]['Name']} is a pre-defined network and cannot be removed")
    if kind == "network" and users:
        fail(f"Error response from daemon: error while removing network: network {match[0]['Name']} has active endpoints "
             f'(name:"{users[0]["Names"]}" id:"{users[0]["ID"]}")')
    for r in match:
        items.remove(r)
    state.setdefault("removed", []).append(" ".join(args))
    print(ref)
    return True


def compose(state, args):
    state.setdefault("compose_calls", []).append(["compose", *args])
    if state.get("compose_fail"):
        return state["compose_fail"]
    p = args[args.index("-p") + 1]
    mine = [c for c in state["containers"] if labels(c).get("com.docker.compose.project") == p]
    for c in mine:
        if "down" in args:
            state["containers"].remove(c)
        elif "up" in args:
            c.update(RUNNING)
    return None


def main(args):
    path = os.environ["FAKE_DOCKER_STATE"]
    cmd, ref = args[0], args[-1]
    action = "remove" if cmd == "rm" else cmd
    if cmd == "logs" and "-f" in args:
        return follow(path, ref)

    if cmd == "exec":
        # terminal: confere o argv que o servidor monta e roda um sh local no lugar do container
        if args[:2] != ["exec", "-it"] or args[3:] != ["sh", "-c", "exec $(command -v bash || echo sh)"]:
            fail(f"exec inesperado: {args}")
        with locked(path, exclusive=False) as (_, state):
            if find(state, args[2])["State"] != "running":
                fail(f"Error response from daemon: container {args[2]} is not running")
        os.environ["PS1"] = "$ "
        os.execvp("sh", ["sh"])

    if action in AFTER or action == "remove":
        # dorme fora do lock, senão o `docker ps` do poll travaria junto
        with locked(path, exclusive=False) as (_, state):
            delay = find(state, ref).get("delay", {}).get(action, 0)
        time.sleep(delay)

    with locked(path, exclusive=True) as (f, state):
        if cmd == "ps":
            if state.get("ps_error"):
                fail(state["ps_error"])
            if "-q" in args:  # ps -a -q --no-trunc: quem usa imagens, volumes e redes
                print("\n".join(c["ID"] for c in state["containers"]))
                return
            for c in state["containers"]:
                if "--filter" not in args:
                    print(json.dumps({k: c.get(k, "") for k in PS_FIELDS}))
                elif "com.docker.compose.project" in labels(c):  # o COMPOSE_FORMAT do servidor
                    print(json.dumps([labels(c).get("com.docker.compose.project" + k, "")
                                      for k in ("", ".working_dir", ".config_files")]))
        elif cmd == "compose":
            err = compose(state, args[1:])
            save(f, state)
            if err:
                fail(err)
        elif cmd == "stats":
            for c in state["containers"]:
                if "stats" in c:
                    print(json.dumps({"ID": c["ID"], "Name": c["Names"], **c["stats"]}))
        elif cmd == "system":
            for row in state.get("df", []):
                print(json.dumps(row))
        elif cmd in ("image", "volume", "network") and args[1] != "prune":
            if objects(state, args):
                save(f, state)
        elif cmd == "container":  # container inspect <ids...>: um array, como o docker
            print(json.dumps([{"Name": "/" + c["Names"], **c.get("inspect", {})}
                              for c in state["containers"] if c["ID"] in args[2:]]))
        elif cmd in PRUNE_TYPE:
            row = next(r for r in state["df"] if r["Type"] == PRUNE_TYPE[cmd])
            freed, row["Reclaimable"] = row["Reclaimable"].split()[0], "0B"
            state.setdefault("pruned", []).append(" ".join(args))
            save(f, state)
            # o builder prune resume diferente dos outros
            print(f"Total:\t{freed}" if cmd == "builder" else f"Total reclaimed space: {freed}")
        elif cmd == "logs":
            sys.stdout.write(find(state, ref).get("logs", ""))
        elif cmd == "inspect":
            c = find(state, ref)
            print(json.dumps(c.get("health") if ".State.Health" in args[-2] else c.get("inspect", {})))
        else:
            c = find(state, ref)
            if action in c.get("fail", {}):
                fail(c["fail"][action])
            if action == "remove":
                state["containers"].remove(c)
            else:
                c.update(c.get("after", {}).get(action) or AFTER[action])
            save(f, state)


if __name__ == "__main__":
    main(sys.argv[1:])
