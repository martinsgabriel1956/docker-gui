{
  "desc": "restart de serviço que não está nos labels: 404",
  "lang": "pt",
  "cli": [
    "docker"
  ],
  "calls": [
    {
      "stdout": "[\"loja\", \"/srv/loja\", \"/srv/loja/compose.yml,/srv/loja/compose.override.yml\", \"api\"]\n[\"loja\", \"/srv/loja\", \"/srv/loja/compose.yml,/srv/loja/compose.override.yml\", \"db\"]\n[\"outro\", \"/srv/outro\", \"/srv/outro/docker-compose.yml\", \"web\"]\n",
      "stderr": "",
      "code": 0,
      "args": [
        "ps",
        "-a",
        "--filter",
        "label=com.docker.compose.project",
        "--format",
        "[{{json (.Label \"com.docker.compose.project\")}},{{json (.Label \"com.docker.compose.project.working_dir\")}},{{json (.Label \"com.docker.compose.project.config_files\")}},{{json (.Label \"com.docker.compose.service\")}}]"
      ]
    }
  ],
  "request": {
    "method": "POST",
    "path": "/api/compose/restart",
    "body": {
      "project": "loja",
      "dir": "/srv/loja",
      "service": "worker"
    }
  },
  "response": {
    "status": 404,
    "body": "serviço não encontrado no projeto"
  }
}
